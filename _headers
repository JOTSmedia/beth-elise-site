# Cache and security headers.
#
# Netlify and Cloudflare Pages read this file as-is. On Apache the same rules
# belong in .htaccess; on nginx, in the server block. The important part is the
# split: HTML must revalidate so a content edit goes live, while the fingerprinted
# and rarely-changing assets can be cached hard.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()

# HTML: always revalidate, so edits are picked up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Fonts are self-hosted and versioned by filename; they never change in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Artwork is regenerated under a new name if it changes.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS carry a ?v= query, so a long TTL is safe.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable
